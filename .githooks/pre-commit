set -e

echo "pre-commit: checking format..."
unformatted=$(gofmt -l $(git ls-files '*.go'))
if [ -n "$unformatted" ]; then
  echo "These files are not formatted. Run: make fmt"
  echo "$unformatted"
  exit 1
fi

echo "pre-commit: go vet..."
go vet ./...

echo "pre-commit: golangci-lint..."
golangci-lint run ./...

echo "pre-commit: quick tests..."
go test -short -count=1 ./... > /dev/null

echo "pre-commit: all good"